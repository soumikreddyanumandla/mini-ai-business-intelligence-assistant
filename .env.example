# ==============================================================================
# Mini AI Business Intelligence Assistant - Environment Configuration
# ==============================================================================

# Server Configuration
API_HOST=127.0.0.1
API_PORT=8000
STREAMLIT_PORT=8501
DEBUG=False
LOG_LEVEL=INFO

# Database Configuration
# Default uses local SQLite database file in the data/ directory
DATABASE_URL=sqlite:///./data/bi_assistant.db
CSV_DATA_PATH=./data/sales.csv

# Generative AI Provider Selection
# Options: 'gemini', 'openai', or 'fallback'
# If no API key is provided, the system gracefully falls back to the deterministic
# rule-and-pattern based intent interpreter (no paid key required for testing/demo).
LLM_PROVIDER=gemini

# Google Gemini API Settings (Optional - enables genuine LLM interpretation)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Settings (Optional alternative LLM provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Safety & Execution Controls
ALLOW_FALLBACK_ON_ERROR=True
MAX_QUERY_LENGTH=500
